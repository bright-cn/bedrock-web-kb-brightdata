# 复制到 .env 并填写。.env 已被 git 忽略。切勿提交真实令牌。

# --- Bright Data ---
BRIGHTDATA_TOKEN=bd_xxxxxxxxxxxxxxxxxxxx
# 你的网络解锁器区域名称，必须与控制面板中显示的完全一致（通常为 web_unlocker
# 或 mcp_unlocker）。错误的区域名称会返回空的 200 响应，而非明显错误；
# 如果某个区域的 IP 允许列表不再匹配你的当前地址，也会出现同样情况（家庭 IP 会轮换，
# 而且 IPv4 与 IPv6 会被视为不同地址）。对于流水线，请关闭允许列表，
# 并使用令牌作为凭证，否则 IP 变化时，计划任务将会中断。
WEB_UNLOCKER_ZONE=web_unlocker
# SERP 区域，仅用于混合式实时检索 (src/web_kb/live_tool.py):
SERP_ZONE=serp_api
# 仅在爬虫 API 扩展路径中需要（脚本默认使用网络解锁器）：
CRAWL_DATASET_ID=

# --- AWS / S3 ---
# 凭证来自标准 boto3 凭证链。若要使用命名配置文件，而不必在
# 每个 shell 中导出它，请在此设置 AWS_PROFILE；boto3 会从环境中读取它。
# AWS_PROFILE=your-profile
AWS_REGION=us-east-1
S3_BUCKET=web-kb-corpus-111122223333
S3_PREFIX=docs

# --- Bedrock 知识库 ---
# 默认使用 Titan Text Embeddings V2；如需使用其他嵌入模型，请覆盖此设置。
EMBEDDING_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0
# RetrieveAndGenerate 的回答模型（你有权访问的任意 Bedrock 文本模型）。
# Nova 2 Lite 是目前高性价比的默认选项；可替换为你的账户所运行的任意模型。
GENERATION_MODEL_ARN=arn:aws:bedrock:us-east-1:111122223333:inference-profile/us.amazon.nova-2-lite-v1:0
# 知识库服务角色（从 infra/, 创建，参见 README）：
KB_ROLE_ARN=arn:aws:iam::111122223333:role/bedrock-web-kb-role

# --- 向量存储：S3 Vectors 路径（默认）---
S3_VECTOR_BUCKET_ARN=arn:aws:s3vectors:us-east-1:111122223333:bucket/web-kb-vectors
S3_VECTOR_INDEX_NAME=web-kb-index
# --- 向量存储：OpenSearch Serverless 路径（备选；使用 --store opensearch）---
OPENSEARCH_COLLECTION_ARN=

# --- 运行 scripts/2_create_kb.py, 后设置，然后粘贴回此处 ---
KNOWLEDGE_BASE_ID=
DATA_SOURCE_ID=
